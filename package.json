{
  "name": "barbearia-saas-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && node scripts/build-pages.mjs",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "deploy:pages": "vite build && node scripts/build-pages.mjs && wrangler pages deploy ./public --cwd dist/pages-deploy --project-name=barbeariachatbot --branch=main",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply barbearia-saas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply barbearia-saas-db --remote",
    "db:seed:local": "wrangler d1 execute barbearia-saas-db --local --file=./seeds/demo.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "hono": "^4.13.18",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/vite": "^4.1.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.161.0"
  }
}
